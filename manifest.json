{
  "manifest_version": 3,
  "name": "Video Ad Blocker Desi",
  "description": "Skip video ads automatically on supported players and HTML5 video sites.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
